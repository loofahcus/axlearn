build --enable_bzlmod

# BEGIN_APPLE
build --extra_toolchains=@apple_federation//tools/jdk:applejdk21_toolchain_definition
build --java_language_version=21
build --java_runtime_version=applejdk_21
build --tool_java_language_version=21
build --tool_java_runtime_version=applejdk_21

common --registry=https://registry.bazel.apple.com
common --remote_instance_name=undisclosed-projects
common --remote_download_toplevel
# END_APPLE
